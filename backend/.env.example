# Molly Backend Configuration
# Copy to .env and fill in values

# LLM Provider (primary - speaks either Anthropic's native Messages API or
# an OpenAI-compatible chat/completions API, auto-detected from base_url/model)
LLM_PROVIDER_NAME=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Optional fallback providers, tried in order if the one before them fails
# after exhausting retries. JSON list of the same shape as above, e.g.:
# LLM_FALLBACK_PROVIDERS=[{"name":"anthropic-backup","provider":"anthropic","base_url":"https://api.anthropic.com/v1","api_key":"sk-ant-...","model":"claude-sonnet-4-6","temperature":0.1,"max_tokens":4096}]
# Easiest to manage from the app's LLM provider settings screen instead of by hand.
LLM_FALLBACK_PROVIDERS=[]

# Retry behavior applied to each provider before the chain moves to the next
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=20.0

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_PATH=data/app.db

# File Storage
UPLOADS_DIR=data/uploads
PROJECTS_DIR=data/projects
MAX_IMAGE_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=50

# Image Cleanup
IMAGE_CLEANUP_DAYS=7
MAX_IMAGES_PER_CONVERSATION=50

# Agent Limits
MAX_ITERATIONS=50
MAX_TOOL_CALLS=100
MAX_EXECUTION_TIME_SECONDS=300
MAX_COMMAND_TIMEOUT_SECONDS=120
MAX_CONTEXT_TOKENS=32000
MAX_TOOL_OUTPUT_CHARS=10000

# Approval
APPROVAL_TIMEOUT_MINUTES=30

# Gemini Live (hands-free voice mode). Get a key at https://aistudio.google.com/apikey
# Leave blank to leave the mic button non-functional - tapping it surfaces
# a "Couldn't start voice session" error in the app rather than crashing,
# but there's no separate feature flag hiding the button itself yet.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE_CONFIRM_WORDS=confirm,confirmed
LIVE_VOICE_CANCEL_WORDS=cancel,cancelled,stop
LIVE_SESSION_MAX_MINUTES=9

# Security
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=*

# Fleet gateway (optional - see ../gateway/README.md and app/tunnel/).
# Leave blank to run exactly as before: a self-hosted, single-tenant
# worker with no gateway involved. After running
# `python -m app.cli worker enroll --gateway <url> --token <token>`,
# either leave this blank (the gateway's enrollment response already
# includes its own ws URL and that's what gets used) or set it explicitly
# to override that.
GATEWAY_WS_URL=

# Logging
LOG_LEVEL=INFO