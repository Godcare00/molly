# Molly Gateway Configuration
# Copy to .env and fill in values

HOST=0.0.0.0
PORT=8080
DEBUG=false

# SQLite is fine for local dev / demoing the split. For real multi-tenant
# traffic, point this at Postgres instead (and add asyncpg to
# requirements.txt in place of aiosqlite):
#   DATABASE_URL=postgresql+asyncpg://molly:password@db.internal/molly_gateway
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# What this gateway tells enrolling workers and admins to use to reach it.
# Update these to your real public hostname before deploying anywhere.
PUBLIC_WS_URL=ws://localhost:8080/worker/connect
PUBLIC_HTTP_URL=http://localhost:8080

# Signs mobile-device access tokens. Generate a real random value for
# production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-this-in-production

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
RELAY_TOKEN_TTL_SECONDS=60
PAIRING_CODE_TTL_MINUTES=10
ENROLLMENT_TOKEN_TTL_MINUTES=15

# Set this to run more than one gateway process (e.g. behind a load
# balancer) - leave blank for single-process mode. See app/tunnel/bus.py.
REDIS_URL=
